{
  "venvPath": ".",
  "venv": "venv",
  "extraPaths": [
    ".",
    "venv/lib/python3.11/site-packages"
  ],
  "include": [
    "."
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "venv",
    "**/__pyrefly_virtual__/**",
    "**/inmemory/**"
  ],
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
